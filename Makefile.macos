CMAKE ?= cmake
CARGO ?= cargo
CTEST ?= ctest
BUILD_DIR ?= build/macos
PREFIX ?= /usr/local

.PHONY: all configure build test install clean

all: build

configure:
	"$(CMAKE)" -S . -B "$(BUILD_DIR)" -G "Unix Makefiles" -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=ON -DRAWDINAL_INSTALL=ON -DRAWDINAL_CARGO:STRING="$(CARGO)"

build: configure
	"$(CMAKE)" --build "$(BUILD_DIR)" --config Release --parallel

test: build
	"$(CARGO)" test --workspace --locked
	"$(CTEST)" --test-dir "$(BUILD_DIR)" -C Release --output-on-failure

install: build
	"$(CMAKE)" --install "$(BUILD_DIR)" --config Release --prefix "$(PREFIX)"

clean:
	if [ -f "$(BUILD_DIR)/CMakeCache.txt" ]; then "$(CMAKE)" --build "$(BUILD_DIR)" --target clean; fi
